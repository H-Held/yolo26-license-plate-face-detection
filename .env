# =============================================================================
# Release metadata for the YOLO26 face & license-plate model.
# Plain KEY=VALUE (.env). Committed AND attached as a release asset.
# Contains ONLY model metadata — NEVER put secrets/tokens here.
# =============================================================================

# --- Identity / version (tag is given by the user) ---
VERSION=v1.1.0
BASE_MODEL=yolo26
MODEL_SIZE=l                 # one of: n | s | m | l | x

# --- Tiling (TILE_* only meaningful when TILES_USED=true) ---
TILES_USED=true
TILE_SIZE=1280               # px, square source tiles (before compression)
TILE_OVERLAP_PCT=20          # overlap between neighbouring tiles, in %

# --- Compression (COMPRESSION_* only meaningful when COMPRESSED=true) ---
# The 1280px tiles were down-scaled to 640px for this model -> infer at imgsz=640.
COMPRESSED=true
COMPRESSION_FORMAT=downscale # 1280 -> 640 resize (INTER_AREA), not lossy codec
COMPRESSION_QUALITY=640      # target square size in px (the model's input size)

# --- Classes the model outputs: index:name, comma-separated. May grow. ---
CLASSES=0:face,1:license-plate
# Recommended per-class inference confidence as index:value (parallel to CLASSES).
# Recall-first ("better over- than under-detect"): highest recall with precision >= 0.5
# on the test+validation set combined. May grow with the classes.
CONF_THRESHOLDS=0:0.02,1:0.03
NUM_CLASSES=2



# --- Evaluation metrics (test split, model v1.1.0, yolo26l @ 640). ---
METRIC_FACE_RECALL=0.165
METRIC_FACE_PRECISION=0.781
METRIC_LICENSE_PLATE_RECALL=0.407
METRIC_LICENSE_PLATE_PRECISION=0.700
METRIC_MAP50=0.302
METRIC_MAP50_95=0.160
