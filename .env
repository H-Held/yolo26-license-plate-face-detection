# =============================================================================
# Release metadata for the YOLO26 face & license-plate model.
# Plain KEY=VALUE (.env). Committed AND attached as a release asset.
# Contains ONLY model metadata — NEVER put secrets/tokens here.
# =============================================================================

# --- Identity / version (tag is given by the user) ---
VERSION=v1.0.0
BASE_MODEL=yolo26
MODEL_SIZE=n                 # one of: n | s | m | l | x

# --- Tiling (TILE_* only meaningful when TILES_USED=true) ---
TILES_USED=true
TILE_SIZE=1280               # px, square tiles
TILE_OVERLAP_PCT=20          # overlap between neighbouring tiles, in %

# --- Compression (COMPRESSION_* only meaningful when COMPRESSED=true) ---
COMPRESSED=false
COMPRESSION_FORMAT=          # e.g. jpeg
COMPRESSION_QUALITY=         # e.g. 85  (the "size"/quality of compression)

# --- Classes the model outputs: index:name, comma-separated. May grow. ---
CLASSES=0:face,1:license-plate
NUM_CLASSES=2

# --- Evaluation metrics (test split, base model v1.0.0). ---
METRIC_FACE_RECALL=0.124
METRIC_FACE_PRECISION=0.855
METRIC_LICENSE_PLATE_RECALL=0.401
METRIC_LICENSE_PLATE_PRECISION=0.720
METRIC_MAP50=0.288
METRIC_MAP50_95=0.147
