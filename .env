# =============================================================================
# Release metadata — auto-generated by model_evaluator.py
# Plain KEY=VALUE (.env). Contains ONLY model metadata — NEVER put secrets/tokens here.
# =============================================================================

# --- Identity / version ---
VERSION=v3.0.0
lowest_compatible_SoftwareVersion=v2.1.1
BASE_MODEL=yolo26
MODEL_SIZE=m

# --- Tiling (TILE_* only meaningful when TILES_USED=true) ---
TILES_USED=true
TILE_SIZE=1280
TILE_OVERLAP_PCT=15.0

# --- Compression (COMPRESSION_* only meaningful when COMPRESSED=true) ---
# If COMPRESSED=true, tiles/ images were down-scaled to COMPRESSION_QUALITY px for training.
# Infer at imgsz=COMPRESSION_QUALITY.
# OUTPUT_QUALITY: 0-100, 100=best quality, 0=worst quality. Use 100 for lossless formats (png, bmp, tiff).
COMPRESSED=true
COMPRESSION_QUALITY=640
OUTPUT_QUALITY=50

# A new option to check the full image for detections, in addition to tiles. This is useful for detecting large objects that may not fit in a tile.
CHECK_FULL_IMAGE=true

# --- Classes the model outputs: index:name, comma-separated. May grow. ---
CLASSES=0:face,1:license-plate

# Recommended per-class inference confidence as index:value (parallel to CLASSES).
# Balanced: highest F1 score (precision and recall maximized together)
# on the test set. May grow with the classes.
CONF_THRESHOLDS=0:0.222,1:0.263
NUM_CLASSES=2

# --- Evaluation metrics (test split, auto-evaluated). ---
METRIC_FACE_RECALL=0.611
METRIC_FACE_PRECISION=0.765
METRIC_LICENSE_PLATE_RECALL=0.703
METRIC_LICENSE_PLATE_PRECISION=0.924
METRIC_MAP50=0.681
METRIC_MAP50_95=0.361
